# ==========================================
# 1. Operating System Files (macOS / Linux / Windows)
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==========================================
# 2. Dependencies & Package Managers
# ==========================================
node_modules/
jspm_packages/
.pnp/
.pnp.*
.yarn/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 3. Environment Variables & Local Secrets
# ==========================================
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# ==========================================
# 4. Build Outputs & Caches
# ==========================================
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.vercel/
.netlify/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ==========================================
# 5. Logs & Runtime Temporary Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

pids/
*.pid
*.seed
*.pid.lock

# ==========================================
# 6. Testing & Coverage Reports
# ==========================================
coverage/
*.lcov
test-results/
playwright-report/
blob-report/
.nyc_output/

# ==========================================
# 7. Editors & IDEs (Keep shared configs or move to global gitignore)
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
